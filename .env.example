# Humbble — Client Environment Template (PR P0-04)
#
# Local setup:
#   1. Copy this template to `.env`:
#        cp .env.example .env
#   2. Populate the variables below with your local Supabase CLI stack or
#      dedicated development Supabase project credentials.
#   3. `.env` and `.env.*` (except `.env.example`) are gitignored. Never commit
#      `.env` files or real credentials to version control.
#
# Security contract (fail-closed):
#   - Every `EXPO_PUBLIC_*` variable is bundled into the client app (Web, iOS,
#     Android) and is visible to end users.
#   - ONLY public client configuration may use the `EXPO_PUBLIC_*` prefix.
#   - NEVER place server-only secrets (`SUPABASE_SERVICE_ROLE_KEY`, database
#     passwords, PayPal client secrets, webhook verification IDs, verification
#     vendor secrets, analytics HMAC salts, or signing keys) in `.env` or under
#     `EXPO_PUBLIC_*`.
#   - Never copy production credentials into local or development environments.
#   - See `docs/setup/P0-04-environment.md` for the full environment contract.

# Required: Supabase project URL
# Example (cloud dev): https://<project-ref>.supabase.co
# Example (local CLI): http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=

# Required (set at least one): Supabase publishable key or anonymous public key.
# `lib/supabase.ts` reads `EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY` first and
# falls back to `EXPO_PUBLIC_SUPABASE_ANON_KEY`.
# Example (publishable): sb_publishable_<public-key>
# Example (legacy anon): eyJ...
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional public EAS project ID for Expo push token registration (used when not injected by EAS).
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional display flags for the member-facing "test payments only" notice. Leave BOTH unset (the default) while
# billing is PayPal Sandbox: the notice is shown. They only hide the notice when set to 'live' AND 'true' together,
# mirroring the server gate (PAYPAL_ENV=live + PAYPAL_ALLOW_LIVE=true). They never enable live payments: the
# checkout function and the database refuse live PayPal on their own. Set them only in the live-billing change.
EXPO_PUBLIC_PAYPAL_ENV=
EXPO_PUBLIC_PAYPAL_ALLOW_LIVE=

# Optional, OPT-IN, default OFF. Anonymous pre-signup quiz funnel events (public.quiz_events).
# Set to 1 (also: true / on) to enable; unset or anything else = nothing is sent or stored.
# Do NOT enable in production until counsel has signed off (legal/drafts/consent-map.md CNS-04a).
# When enabled the quiz shows a small notice with a Privacy link and an Opt out control.
# Details: docs/operations/quiz-funnel-events.md. Public value (bundled into the client): not a secret.
EXPO_PUBLIC_QUIZ_ANALYTICS=
