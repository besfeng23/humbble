{
  "expo": {
    "name": "Sincera Preview",
    "slug": "humbble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "humbble",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.banataosystems.humbble"
    },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/images/adaptive-icon.png", "backgroundColor": "#ffffff" },
      "package": "com.banataosystems.humbble"
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/images/splash-icon.png", "imageWidth": 300, "resizeMode": "contain", "backgroundColor": "#ffca55" }],
      ["expo-image-picker", { "photosPermission": "Sincera accesses selected photos so you can add them to your profile.", "cameraPermission": false, "microphonePermission": false }],
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": true }
  }
}
